datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[] @relation("RolePermissions")
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  roles       Role[]  @relation("RolePermissions")
}

model User {
  id                  Int            @id @default(autoincrement())
  email               String         @unique
  username            String         @unique
  passwordHash        String         @map("password_hash")
  avatar              String?
  country             String?
  isVerified          Boolean        @default(false) @map("is_verified")
  verificationToken   String?        @map("verification_token")
  resetToken          String?        @map("reset_token")
  resetTokenExpires   DateTime?      @map("reset_token_expires")
  roleId              Int            @map("role_id")
  role                Role           @relation(fields: [roleId], references: [id])
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  
  submissions         Submission[]
  progress            Progress[]
  auditLogs           AuditLog[]
  adminLogs           AdminLog[]
  supportTickets      SupportTicket[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  badges              UserBadge[]

  @@map("users")
}

model Challenge {
  id            Int          @id @default(autoincrement())
  title         String
  difficulty    String       // Easy, Medium, Hard
  description   String       @db.Text
  objectives    String       @db.Text
  categoryId    Int          @map("category_id")
  category      Category     @relation(fields: [categoryId], references: [id])
  points        Int
  tags          String       // comma-separated tags
  estimatedTime Int          @map("estimated_time") // in minutes
  isActive      Boolean      @default(true) @map("is_active")
  dockerImage   String?      @map("docker_image")
  sourceCodeUrl String?      @map("source_code_url")
  createdAt     DateTime     @default(now()) @map("created_at")
  
  flags         Flag[]
  hints         Hint[]
  submissions   Submission[]

  @@map("challenges")
}

model Category {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?     
  challenges  Challenge[]

  @@map("categories")
}

model Flag {
  id          Int       @id @default(autoincrement())
  challengeId Int       @map("challenge_id")
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  flagHash    String    @map("flag_hash") // MD5/SHA256 hash of flag to avoid flag leak in DB
  isDynamic   Boolean   @default(false) @map("is_dynamic")

  @@map("flags")
}

model Hint {
  id          Int       @id @default(autoincrement())
  challengeId Int       @map("challenge_id")
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  content     String    
  costPoints  Int       @default(0) @map("cost_points")

  @@map("hints")
}

model Submission {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId   Int       @map("challenge_id")
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submittedFlag String    @map("submitted_flag")
  isCorrect     Boolean   @map("is_correct")
  submittedAt   DateTime  @default(now()) @map("submitted_at")

  @@map("submissions")
}

model AcademyTopic {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  
  orderIndex  Int      @map("order_index")
  lessons     Lesson[]

  @@map("academy_topics")
}

model Lesson {
  id              Int          @id @default(autoincrement())
  topicId         Int          @map("topic_id")
  topic           AcademyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title           String
  contentMarkdown String       @map("content_markdown") @db.Text
  orderIndex      Int          @map("order_index")
  progresses      Progress[]
  quizzes         Quiz[]

  @@map("lessons")
}

model Progress {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    Int      @map("lesson_id")
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt DateTime @default(now()) @map("completed_at")

  @@unique([userId, lessonId])
  @@map("progress")
}

model Quiz {
  id            Int    @id @default(autoincrement())
  lessonId      Int    @map("lesson_id")
  lesson        Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question      String       @db.Text
  optionsJson   String @map("options_json") @db.Text // JSON array of options
  correctOption String @map("correct_option") // correct option text

  @@map("quizzes")
}

model Badge {
  id             Int         @id @default(autoincrement())
  name           String      @unique
  description    String      
  iconUrl        String      @map("icon_url")
  pointsRequired Int         @map("points_required")
  users          UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   Int      @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  Int      @map("badge_id")
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now()) @map("earned_at")

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique @map("session_token")
  expiresAt    DateTime @map("expires_at")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")

  @@map("sessions")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")

  @@map("refresh_tokens")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?  
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?  
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_logs")
}

model SupportTicket {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String   
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("LOW")  // LOW, MEDIUM, HIGH, CRITICAL
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("support_tickets")
}

model Feedback {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  messageType  String   @map("message_type") // FEEDBACK, BUG_REPORT, FEATURE_REQUEST, GENERAL_SUPPORT
  feedbackText String   @map("feedback_text")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
